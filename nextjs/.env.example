# Copy to .env.local. Restart `pnpm dev` after editing; this file is read at startup.

# /shot-list sends stills to a vision model on OpenRouter for a coverage check.
OPENROUTER_API_KEY=
# Optional: the default model (the page offers Gemini 3.1 Pro and Gemini 3.8 Flash either way).
OPENROUTER_MODEL=
